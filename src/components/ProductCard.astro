---
export interface Props {
  name: string
  description: string
  price: number
  category: string
  image?: string
  available: boolean
}

const { name, description, price, image, available } = Astro.props
---

<div class={`group relative bg-white border border-stone-100 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 ${!available ? 'opacity-50' : ''}`}>
  {image ? (
    <div class="h-44 overflow-hidden bg-stone-50">
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  ) : (
    <div class="h-44 bg-stone-50 flex items-center justify-center">
      <span class="text-4xl opacity-20">☕</span>
    </div>
  )}

  <div class="p-5">
    <div class="flex items-start justify-between gap-2 mb-1">
      <h3 class="font-semibold text-stone-800 text-base leading-snug">{name}</h3>
      <span class="text-stone-900 font-bold text-base whitespace-nowrap">${price.toFixed(2)}</span>
    </div>
    <p class="text-stone-400 text-sm leading-relaxed line-clamp-2">{description}</p>
    {!available && (
      <span class="inline-block mt-3 text-xs text-stone-400 bg-stone-100 px-2 py-0.5 rounded-full">No disponible</span>
    )}
  </div>
</div>