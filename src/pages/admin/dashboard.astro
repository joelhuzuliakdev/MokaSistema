---
import AdminLayout from '../../layouts/AdminLayout.astro'
---

<AdminLayout title="Dashboard — Admin">

  <div class="bg-[#f8f7f5] min-h-screen flex">

    <!-- Sidebar -->
    <aside class="hidden md:flex flex-col w-56 bg-stone-900 text-stone-300 py-8 px-5 fixed h-full z-20">
      <div class="mb-10">
        <p class="text-xs tracking-[0.25em] uppercase text-stone-500 mb-1">Panel</p>
        <h1 class="font-['Cormorant_Garamond'] text-xl font-light tracking-widest uppercase text-stone-100">Admin</h1>
      </div>
      <nav class="flex flex-col gap-1 flex-1">
        <button onclick="showSection('products')" id="nav-products"
          class="nav-btn text-left px-3 py-2.5 rounded-xl text-xs tracking-widest uppercase transition-all hover:bg-stone-800 text-stone-400 hover:text-stone-200">
          Productos
        </button>
        <button onclick="showSection('add')" id="nav-add"
          class="nav-btn text-left px-3 py-2.5 rounded-xl text-xs tracking-widest uppercase transition-all hover:bg-stone-800 text-stone-400 hover:text-stone-200">
          + Agregar
        </button>
      </nav>
      <div class="border-t border-stone-800 pt-5 mt-5">
        <a href="/" target="_blank" class="block text-xs tracking-widest uppercase text-stone-500 hover:text-stone-300 transition-colors mb-3">
          Ver carta ↗
        </a>
        <button id="logout-btn" class="text-xs tracking-widest uppercase text-stone-500 hover:text-red-400 transition-colors cursor-pointer">
          Cerrar sesión
        </button>
      </div>
    </aside>

    <!-- Mobile header -->
    <header class="md:hidden fixed top-0 left-0 right-0 z-20 bg-stone-900 px-5 py-4 flex items-center justify-between">
      <h1 class="font-['Cormorant_Garamond'] text-lg font-light tracking-widest uppercase text-stone-100">Admin</h1>
      <div class="flex gap-3 items-center">
        <button onclick="showSection('products')" class="text-xs text-stone-400 tracking-widest uppercase hover:text-stone-200 transition-colors">Lista</button>
        <button onclick="showSection('add')" class="text-xs text-amber-500 tracking-widest uppercase">+ Agregar</button>
        <button id="logout-btn-mobile" class="text-xs text-stone-500 tracking-widest uppercase hover:text-red-400 transition-colors ml-2">Salir</button>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1 md:ml-56 pt-16 md:pt-0">
      <div class="max-w-4xl mx-auto px-5 md:px-10 py-8 md:py-10">

        <!-- Section: Products -->
        <section id="section-products">
          <div class="flex items-center justify-between mb-8">
            <div>
              <p class="text-xs tracking-[0.25em] uppercase text-stone-400 mb-1">Gestión de</p>
              <h2 class="font-['Cormorant_Garamond'] text-3xl font-light text-stone-800">Productos</h2>
            </div>
            <button onclick="showSection('add')"
              class="hidden md:flex items-center gap-2 bg-stone-900 hover:bg-stone-800 text-stone-100 text-xs tracking-widest uppercase px-4 py-2.5 rounded-xl transition-all cursor-pointer">
              + Agregar
            </button>
          </div>

          <!-- Filters -->
          <div class="flex gap-3 mb-6 flex-wrap">
            <input id="search-input" type="text" placeholder="Buscar producto…"
              class="flex-1 min-w-[180px] bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm placeholder-stone-400 focus:outline-none focus:border-stone-400 transition-all" />
            <select id="filter-category"
              class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm text-stone-600 focus:outline-none focus:border-stone-400 transition-all cursor-pointer">
              <option value="">Todas las categorías</option>
            </select>
            <select id="filter-available"
              class="bg-white border border-stone-200 rounded-xl px-4 py-2.5 text-sm text-stone-600 focus:outline-none focus:border-stone-400 transition-all cursor-pointer">
              <option value="">Todos</option>
              <option value="true">Disponibles</option>
              <option value="false">No disponibles</option>
            </select>
          </div>

          <!-- Debug info -->
          <div id="debug-info" class="hidden bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-4 text-xs text-amber-800 font-mono"></div>

          <div id="products-loading" class="text-center py-16 text-stone-400 text-sm tracking-wide">Cargando productos…</div>
          <div id="products-list" class="hidden space-y-2"></div>
          <div id="products-empty" class="hidden text-center py-16">
            <p class="text-4xl mb-4">☕</p>
            <p class="text-stone-400 text-sm tracking-wide">No hay productos todavía.</p>
          </div>
        </section>

        <!-- Section: Add / Edit -->
        <section id="section-add" class="hidden">
          <div class="mb-8">
            <p class="text-xs tracking-[0.25em] uppercase text-stone-400 mb-1" id="form-subtitle">Nuevo</p>
            <h2 class="font-['Cormorant_Garamond'] text-3xl font-light text-stone-800" id="form-title">Producto</h2>
          </div>

          <div class="bg-white border border-stone-100 rounded-2xl p-6 md:p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <div class="md:col-span-2">
                <label class="block text-xs tracking-widest uppercase text-stone-400 mb-2">Nombre *</label>
                <input id="f-name" type="text" placeholder="Ej: Cappuccino artesanal"
                  class="w-full bg-stone-50 border border-stone-200 rounded-xl px-4 py-3 text-sm placeholder-stone-400 focus:outline-none focus:border-amber-600/50 focus:ring-1 focus:ring-amber-600/10 transition-all" />
              </div>

              <div class="md:col-span-2">
                <label class="block text-xs tracking-widest uppercase text-stone-400 mb-2">Descripción</label>
                <textarea id="f-description" rows="3" placeholder="Describí el producto…"
                  class="w-full bg-stone-50 border border-stone-200 rounded-xl px-4 py-3 text-sm placeholder-stone-400 focus:outline-none focus:border-amber-600/50 focus:ring-1 focus:ring-amber-600/10 transition-all resize-none"></textarea>
              </div>

              <div>
                <label class="block text-xs tracking-widest uppercase text-stone-400 mb-2">Precio *</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-stone-400 text-sm">$</span>
                  <input id="f-price" type="text" inputmode="numeric" placeholder="Ej: 1.500"
                    class="w-full bg-stone-50 border border-stone-200 rounded-xl pl-8 pr-4 py-3 text-sm placeholder-stone-400 focus:outline-none focus:border-amber-600/50 focus:ring-1 focus:ring-amber-600/10 transition-all" />
                </div>
              </div>

              <div>
                <label class="block text-xs tracking-widest uppercase text-stone-400 mb-2">Categoría *</label>
                <input id="f-category" type="text" placeholder="Ej: Cafés, Tortas…"
                  class="w-full bg-stone-50 border border-stone-200 rounded-xl px-4 py-3 text-sm placeholder-stone-400 focus:outline-none focus:border-amber-600/50 focus:ring-1 focus:ring-amber-600/10 transition-all" />
                <div id="category-suggestions" class="flex flex-wrap gap-1.5 mt-2"></div>
              </div>

              <!-- Campo: image (coincide con la columna de Supabase) -->
              <div class="md:col-span-2">
                <label class="block text-xs tracking-widest uppercase text-stone-400 mb-2">URL de imagen</label>
                <input id="f-image" type="url" placeholder="https://…"
                  class="w-full bg-stone-50 border border-stone-200 rounded-xl px-4 py-3 text-sm placeholder-stone-400 focus:outline-none focus:border-amber-600/50 focus:ring-1 focus:ring-amber-600/10 transition-all" />
              </div>

              <div class="md:col-span-2 flex items-center gap-3">
                <button id="f-available-toggle" onclick="toggleAvailable()"
                  class="relative inline-flex h-6 w-11 items-center rounded-full bg-amber-600 transition-colors cursor-pointer">
                  <span id="f-available-dot" class="inline-block h-4 w-4 transform translate-x-6 rounded-full bg-white transition-transform shadow-sm"></span>
                </button>
                <span class="text-sm text-stone-600">Disponible</span>
                <input type="hidden" id="f-available" value="true" />
              </div>

            </div>

            <p id="form-error" class="text-red-400 text-xs mt-4 hidden tracking-wide"></p>

            <div class="flex gap-3 mt-7 pt-6 border-t border-stone-100">
              <button id="save-btn" onclick="saveProduct()"
                class="flex-1 md:flex-none bg-stone-900 hover:bg-stone-800 text-stone-100 text-xs tracking-widest uppercase px-6 py-3 rounded-xl transition-all cursor-pointer">
                Guardar producto
              </button>
              <button onclick="cancelEdit()"
                class="text-xs tracking-widest uppercase text-stone-400 hover:text-stone-700 transition-colors px-4 cursor-pointer">
                Cancelar
              </button>
            </div>
          </div>
        </section>

      </div>
    </main>
  </div>

  <!-- Delete modal -->
  <div id="delete-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center px-4">
    <div class="bg-white rounded-2xl p-7 max-w-sm w-full shadow-2xl">
      <h3 class="font-['Cormorant_Garamond'] text-2xl font-light text-stone-800 mb-2">Eliminar producto</h3>
      <p class="text-stone-500 text-sm mb-6">Esta acción no se puede deshacer. ¿Estás seguro/a?</p>
      <div class="flex gap-3">
        <button id="confirm-delete-btn"
          class="flex-1 bg-red-500 hover:bg-red-600 text-white text-xs tracking-widest uppercase py-3 rounded-xl transition-all cursor-pointer">
          Eliminar
        </button>
        <button onclick="closeDeleteModal()"
          class="flex-1 bg-stone-100 hover:bg-stone-200 text-stone-600 text-xs tracking-widest uppercase py-3 rounded-xl transition-all cursor-pointer">
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 hidden">
    <div id="toast-inner" class="text-xs tracking-wide px-5 py-3 rounded-xl shadow-2xl bg-stone-900 text-stone-100">
      <span id="toast-msg"></span>
    </div>
  </div>

</AdminLayout>

<script is:inline>
    const SUPABASE_URL = 'https://flqturvavxpcupwqgzca.supabase.co'
    const SUPABASE_KEY = 'sb_publishable_IpkF6GD4-Pi5GmUw1ylVfw_WcThbMQB'

    // ── Auth check ────────────────────────────────────────
    if (sessionStorage.getItem('admin_auth') !== 'true') {
      window.location.href = '/admin'
    }

    function parsePrice(val) {
      // Elimina puntos de miles, reemplaza coma decimal por punto
      return parseFloat(val.replace(/\./g, '').replace(',', '.'))
    }

    // ── Supabase client (sin SDK, fetch directo) ──────────
    async function sbFetch(path, options = {}) {
      const url = `${SUPABASE_URL}/rest/v1/${path}`
      const res = await fetch(url, {
        ...options,
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${SUPABASE_KEY}`,
          'Content-Type': 'application/json',
          'Prefer': options.prefer || '',
          ...(options.headers || {})
        }
      })
      if (!res.ok) {
        const err = await res.text()
        throw new Error(err)
      }
      const text = await res.text()
      return text ? JSON.parse(text) : null
    }

    // ── State ─────────────────────────────────────────────
    let allProducts = []
    let editingId = null
    let deleteTargetId = null
    let isAvailable = true

    // ── Navigation ────────────────────────────────────────
    window.showSection = function(section) {
      document.getElementById('section-products').classList.toggle('hidden', section !== 'products')
      document.getElementById('section-add').classList.toggle('hidden', section !== 'add')
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('bg-stone-800', 'text-stone-100'))
      const active = document.getElementById(`nav-${section}`)
      if (active) active.classList.add('bg-stone-800', 'text-stone-100')
      if (section === 'add' && !editingId) resetForm()
    }

    // ── Load products ─────────────────────────────────────
    async function loadProducts() {
      showSection('products')
      document.getElementById('products-loading').classList.remove('hidden')
      document.getElementById('products-list').classList.add('hidden')
      document.getElementById('products-empty').classList.add('hidden')
      document.getElementById('debug-info').classList.add('hidden')

      try {
        // La columna en tu tabla es "image", no "image_url"
        const data = await sbFetch('products?select=id,name,description,price,category,image,available,created_at&order=category.asc,name.asc')
        document.getElementById('products-loading').classList.add('hidden')
        allProducts = data || []
        populateCategoryFilter()
        renderProducts(allProducts)
      } catch (err) {
        document.getElementById('products-loading').classList.add('hidden')
        const debug = document.getElementById('debug-info')
        debug.textContent = `Error: ${err.message}`
        debug.classList.remove('hidden')
        showToast('Error al cargar productos', 'error')
      }
    }

    function populateCategoryFilter() {
      const cats = [...new Set(allProducts.map(p => p.category).filter(Boolean))].sort()
      const sel = document.getElementById('filter-category')
      sel.innerHTML = '<option value="">Todas las categorías</option>'
      cats.forEach(c => {
        const opt = document.createElement('option')
        opt.value = c; opt.textContent = c
        sel.appendChild(opt)
      })
      // Sugerencias en el formulario
      const sugg = document.getElementById('category-suggestions')
      sugg.innerHTML = ''
      cats.forEach(c => {
        const btn = document.createElement('button')
        btn.textContent = c
        btn.className = 'text-xs text-stone-500 bg-stone-100 hover:bg-stone-200 px-2.5 py-1 rounded-lg transition-colors cursor-pointer'
        btn.onclick = () => { document.getElementById('f-category').value = c }
        sugg.appendChild(btn)
      })
    }

    function renderProducts(products) {
      const list = document.getElementById('products-list')
      const empty = document.getElementById('products-empty')

      if (!products || products.length === 0) {
        list.classList.add('hidden')
        empty.classList.remove('hidden')
        return
      }

      empty.classList.add('hidden')
      list.classList.remove('hidden')
      list.innerHTML = ''

      products.forEach(p => {
        const row = document.createElement('div')
        row.className = 'bg-white border border-stone-100 rounded-2xl px-5 py-4 flex items-center gap-4 hover:border-stone-200 transition-all group'
        // IMPORTANTE: la columna es "image", no "image_url"
        row.innerHTML = `
          <div class="w-10 h-10 rounded-xl overflow-hidden bg-stone-100 flex-shrink-0">
            ${p.image
              ? `<img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-stone-400 text-lg\'>☕</div>'" />`
              : `<div class="w-full h-full flex items-center justify-center text-stone-400 text-lg">☕</div>`
            }
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <p class="font-medium text-stone-800 text-sm truncate">${p.name}</p>
              <span class="text-xs px-2 py-0.5 rounded-full ${p.available ? 'bg-emerald-50 text-emerald-600' : 'bg-stone-100 text-stone-400'}">
                ${p.available ? 'Disponible' : 'No disponible'}
              </span>
            </div>
            <p class="text-xs text-stone-400 mt-0.5">${p.category || '—'} · $${Number(p.price).toLocaleString('es-AR')}</p>
          </div>
          <div class="flex items-center gap-1 md:opacity-0 md:group-hover:opacity-100 transition-opacity">
            <button onclick="editProduct(${p.id})"
              class="text-xs text-stone-500 hover:text-stone-900 bg-stone-50 hover:bg-stone-100 px-3 py-1.5 rounded-lg transition-all cursor-pointer">
              Editar
            </button>
            <button onclick="openDeleteModal(${p.id})"
              class="text-xs text-red-400 hover:text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-all cursor-pointer">
              Eliminar
            </button>
          </div>`
        list.appendChild(row)
      })
    }

    // ── Filters ───────────────────────────────────────────
    function applyFilters() {
      const search = document.getElementById('search-input').value.toLowerCase()
      const category = document.getElementById('filter-category').value
      const available = document.getElementById('filter-available').value
      renderProducts(allProducts.filter(p =>
        (!search || p.name.toLowerCase().includes(search) || (p.description || '').toLowerCase().includes(search)) &&
        (!category || p.category === category) &&
        (available === '' || p.available.toString() === available)
      ))
    }
    document.getElementById('search-input').addEventListener('input', applyFilters)
    document.getElementById('filter-category').addEventListener('change', applyFilters)
    document.getElementById('filter-available').addEventListener('change', applyFilters)

    // ── Toggle disponible ─────────────────────────────────
    window.toggleAvailable = function() { setAvailable(!isAvailable) }

    function setAvailable(val) {
      isAvailable = val
      document.getElementById('f-available').value = val.toString()
      const toggle = document.getElementById('f-available-toggle')
      const dot = document.getElementById('f-available-dot')
      toggle.classList.toggle('bg-amber-600', val)
      toggle.classList.toggle('bg-stone-300', !val)
      dot.classList.toggle('translate-x-6', val)
      dot.classList.toggle('translate-x-1', !val)
    }

    // ── Form ──────────────────────────────────────────────
    function resetForm() {
      editingId = null
      document.getElementById('form-subtitle').textContent = 'Nuevo'
      document.getElementById('form-title').textContent = 'Producto'
      document.getElementById('save-btn').textContent = 'Guardar producto'
      ;['f-name','f-description','f-price','f-category','f-image'].forEach(id => {
        document.getElementById(id).value = ''
      })
      document.getElementById('form-error').classList.add('hidden')
      setAvailable(true)
    }

    window.editProduct = function(id) {
      const p = allProducts.find(x => x.id === id)
      if (!p) return
      editingId = id
      document.getElementById('form-subtitle').textContent = 'Editar'
      document.getElementById('form-title').textContent = p.name
      document.getElementById('save-btn').textContent = 'Actualizar producto'
      document.getElementById('f-name').value = p.name || ''
      document.getElementById('f-description').value = p.description || ''
      document.getElementById('f-price').value = p.price ? Number(p.price).toLocaleString('es-AR') : ''
      document.getElementById('f-category').value = p.category || ''
      // columna "image"
      document.getElementById('f-image').value = p.image || ''
      setAvailable(p.available !== false)
      showSection('add')
    }

    window.cancelEdit = function() { resetForm(); showSection('products') }

    window.saveProduct = async function() {
      const name = document.getElementById('f-name').value.trim()
      const description = document.getElementById('f-description').value.trim()
      const price = parsePrice(document.getElementById('f-price').value)
      const category = document.getElementById('f-category').value.trim()
      // columna "image" (igual que en Supabase)
      const image = document.getElementById('f-image').value.trim() || null
      const available = document.getElementById('f-available').value === 'true'
      const errorEl = document.getElementById('form-error')
      errorEl.classList.add('hidden')

      if (!name || !category || isNaN(price) || price <= 0) {
        errorEl.textContent = 'Completá los campos obligatorios: nombre, precio y categoría.'
        errorEl.classList.remove('hidden')
        return
      }

    // El payload usa "image", no "image_url"
    const payload = { name, description, price, category, image, available }

    try {
        if (editingId) {
            await sbFetch(`products?id=eq.${editingId}`, {
                method: 'PATCH',
                prefer: 'return=minimal',
                body: JSON.stringify(payload)
            })
        } else {
            await sbFetch('products', {
                method: 'POST',
                prefer: 'return=minimal',
                body: JSON.stringify(payload)
            })
        }
        showToast(editingId ? 'Producto actualizado ✓' : 'Producto creado ✓')
        resetForm()
        await loadProducts()
        } catch (err) {
            errorEl.textContent = `Error al guardar: ${err.message}`
            errorEl.classList.remove('hidden')
        }
    }

    // ── Delete ────────────────────────────────────────────
    window.openDeleteModal = function(id) {
        deleteTargetId = id
        document.getElementById('delete-modal').classList.remove('hidden')
    }
    window.closeDeleteModal = function() {
        deleteTargetId = null
        document.getElementById('delete-modal').classList.add('hidden')
    }
    document.getElementById('confirm-delete-btn').addEventListener('click', async () => {
        if (!deleteTargetId) return
        try {
            await sbFetch(`products?id=eq.${deleteTargetId}`, { method: 'DELETE' })
            showToast('Producto eliminado')
        } catch (err) {
            showToast('Error al eliminar', 'error')
        }
        closeDeleteModal()
        await loadProducts()
    })
    document.getElementById('delete-modal').addEventListener('click', e => {
        if (e.target === document.getElementById('delete-modal')) closeDeleteModal()
    })

    // ── Toast ─────────────────────────────────────────────
    let toastTimer
    function showToast(msg, type = 'success') {
        const inner = document.getElementById('toast-inner')
        document.getElementById('toast-msg').textContent = msg
        inner.className = `text-xs tracking-wide px-5 py-3 rounded-xl shadow-2xl ${type === 'error' ? 'bg-red-800 text-red-100' : 'bg-stone-900 text-stone-100'}`
        document.getElementById('toast').classList.remove('hidden')
        clearTimeout(toastTimer)
        toastTimer = setTimeout(() => document.getElementById('toast').classList.add('hidden'), 3000)
    }

    // ── Logout ────────────────────────────────────────────
    function logout() { sessionStorage.removeItem('admin_auth'); window.location.href = '/admin' }
    document.getElementById('logout-btn').addEventListener('click', logout)
    document.getElementById('logout-btn-mobile').addEventListener('click', logout)

    // ── Init ──────────────────────────────────────────────
    loadProducts()
    showSection('products')

    // ── Unsaved changes warning ───────────────────────────
    window.addEventListener('beforeunload', e => {
      const section = !document.getElementById('section-add').classList.contains('hidden')
      const hasContent = document.getElementById('f-name').value.trim() !== ''
      if (section && hasContent) {
        e.preventDefault()
      }
    })
</script>