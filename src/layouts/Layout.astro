---
import '../styles/global.css';
export interface Props {
	title: string
	description?: string
}

const {
	title,
	description = 'Descubre nuestra selección de cafés de especialidad, bebidas artesanales y acompañamientos preparados con ingredientes de calidad.'
} = Astro.props
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="icon" type="image/png" href="/inicialLogo.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Jost:wght@300;400;500&display=swap" media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Jost:wght@300;400;500&display=swap" /></noscript>
	</head>
	<body class="min-h-screen" style="background-color: #f5ede0; font-family: 'Jost', sans-serif; color: #1a0f00;">
		<slot />
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
	}
	html, body {
		margin: 0;
		padding: 0;
	}
</style>